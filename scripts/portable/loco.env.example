# LOCO.exe 옆의 loco.env를 메모장으로 수정하고 앱을 다시 실행하세요.
# Windows 환경 변수가 이미 있으면 그 값이 우선합니다.
# 실제 API 키는 공유하거나 배포 파일에 포함하지 마세요.
OPENAI_API_KEY=
# OpenAI 호환 서버를 사용하는 경우에만 주소를 입력하세요.
OPENAI_BASE_URL=
LOCO_AI_MODEL=gpt-6-luna
LOCO_AI_REASONING_EFFORT=high
LOCO_AI_MAX_OUTPUT_TOKENS=32768
LOCO_POSE_MODEL_ID=mediapipe-heavy
# 모델·추론 설정은 처음 생성되는 DB의 초기값이며 기존 저장 설정이 우선합니다.
# 기본 DB: Windows 사용자별 LOCALAPPDATA/LOCO/loco_demo.db
# 별도 DB가 필요할 때만 입력하세요. 상대 경로는 LOCO.exe 폴더 기준입니다.
# LOCO_DB_PATH=data/loco.db
